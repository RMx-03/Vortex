{
  "schema_version": 1,
  "maximum_text_bytes": 1048576,
  "allowed_exacts": [
    "README.md",
    "CODE_QUALITY.md",
    "CONTRIBUTING.md",
    "pyproject.toml",
    ".gitignore",
    ".github/PULL_REQUEST_TEMPLATE.md",
